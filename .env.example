# DOKI AI Assistant - Environment Variables
# Configure these in Vercel Dashboard -> Settings -> Environment Variables

# 1. OpenRouter API Key (Free tier - get one from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 2. OpenRouter Model (Default: free dynamic router)
OPENROUTER_MODEL=openrouter/free

# 3. Environment (production / development)
APP_ENV=production

# 4. Frontend Origin for CORS (e.g., https://your-project.vercel.app or * for all)
FRONTEND_ORIGIN=*
